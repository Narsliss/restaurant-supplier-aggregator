#!/usr/bin/env bash
# Git pre-push hook: refuses any push to main that would carry demo code.
# Installed (with Carmin's OK) as .git/hooks/pre-push, it covers every
# worktree and every push from this machine. Pushes of other branches,
# including demo itself, are untouched.
#
# Git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
set -uo pipefail

zero=0000000000000000000000000000000000000000
demo_paths=(demo config/initializers/demo_mode.rb spec/demo)
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue # deleting main: not our business

  # 1. The commit being pushed must not contain any demo file.
  for p in "${demo_paths[@]}"; do
    if [ -n "$(git ls-tree --name-only "$local_sha" -- "$p" 2>/dev/null)" ]; then
      echo "pre-push: refusing to push demo code to main ($p is in $local_sha)." >&2
      status=1
    fi
  done

  # 2. No commit being added to main may have touched a demo file, even if a
  #    later commit removed it again.
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  if [ -n "$(git log --format=%h "$range" -- "${demo_paths[@]}" 2>/dev/null | head -1)" ]; then
    echo "pre-push: refusing to push to main: commits in $range touch demo files." >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: demo code lives only on the demo branch (docs/plan-demo-site-offline-suppliers.md)." >&2
fi
exit "$status"
