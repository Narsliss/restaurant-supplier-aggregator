<div style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1f2937;">
  <div style="padding: 32px 24px;">
    <h1 style="font-size: 24px; font-weight: 700; margin-bottom: 16px; color: #111827;">
      Your price comparison is ready
    </h1>

    <p style="font-size: 16px; line-height: 1.6; color: #4b5563; margin-bottom: 16px;">
      Hi <%= @owner.first_name.presence || "there" %>,
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #4b5563; margin-bottom: 24px;">
      We finished lining up your order guides<%= " for #{@location.name}" if @location %>.
      <strong><%= @matched %></strong> <%= "product".pluralize(@matched) %>
      <%= @matched == 1 ? "is" : "are" %> now priced side by side across
      <%= @suppliers.map(&:name).to_sentence.presence || "your suppliers" %>.
    </p>

    <div style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px;">
      <table style="width: 100%; font-size: 15px; color: #4b5563;">
        <tr>
          <td style="padding: 4px 0;">Products on your list</td>
          <td style="padding: 4px 0; text-align: right; font-weight: 600; color: #111827;"><%= @total %></td>
        </tr>
        <tr>
          <td style="padding: 4px 0;">Matched across suppliers</td>
          <td style="padding: 4px 0; text-align: right; font-weight: 600; color: #15803d;"><%= @matched %></td>
        </tr>
        <% if @unmatched > 0 %>
          <tr>
            <td style="padding: 4px 0;">Still needing a look</td>
            <td style="padding: 4px 0; text-align: right; font-weight: 600; color: #b45309;"><%= @unmatched %></td>
          </tr>
        <% end %>
      </table>
    </div>

    <% if @unmatched > 0 %>
      <p style="font-size: 16px; line-height: 1.6; color: #4b5563; margin-bottom: 24px;">
        We couldn't find a confident match for <%= @unmatched %> of them — usually a
        product only one supplier carries, or one whose name differs too much between
        catalogs. You can match those by hand, and confirm the ones we got right.
      </p>
    <% end %>

    <div style="text-align: center; margin-bottom: 24px;">
      <a href="<%= aggregated_list_url(@aggregated_list) %>" style="display: inline-block; background-color: #15803d; color: #ffffff; font-weight: 600; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-size: 16px;">
        Review your matches
      </a>
    </div>

    <p style="font-size: 14px; line-height: 1.6; color: #6b7280; margin-bottom: 0;">
      Prices refresh automatically every day, so this list stays current without you touching it.
    </p>
  </div>
</div>
