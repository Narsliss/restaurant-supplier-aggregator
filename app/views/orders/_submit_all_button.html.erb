<%# The review page's primary action, rendered at the top and the bottom.
    order_ids holds ONLY the orders that are ready right now, so "Submit 2 of 3"
    sends 2. Off while any order is still checking prices.
    order-review#_updateSubmitStates rewrites the ids, label and state as prices
    verify and the chef edits quantities or dates.
    Locals: review_orders, batch_id, aggregated_list_id, size (:regular | :large) %>
<% checking = review_orders.any? { |r| r[:verification_status].in?(Order::CHECKING_VERIFICATION_STATUSES) } %>
<% ready = review_orders.select { |r| r[:has_credentials] && r[:meets_minimum] && r[:meets_case_minimum] && !r[:order].verifying? && r[:verification_status].in?(%w[verified price_changed skipped]) } %>
<% can_submit_all = ready.any? && !checking %>
<% label = if checking then "Checking prices…"
           elsif ready.size == review_orders.size then "Submit All Orders"
           else "Submit #{ready.size} of #{review_orders.size} Orders"
           end %>
<% size_classes = size == :large ? "px-8 py-3 text-base font-bold" : "px-5 py-2 text-sm font-semibold" %>
<%= button_to label,
    submit_batch_orders_path(batch_id: batch_id, order_ids: ready.map { |r| r[:order].id }, aggregated_list_id: aggregated_list_id),
    method: :post,
    disabled: !can_submit_all,
    class: "w-full sm:w-auto rounded-md shadow-sm text-center #{size_classes} #{can_submit_all ? 'text-white bg-brand-orange hover:bg-brand-orange-dark cursor-pointer' : 'text-gray-400 bg-gray-600 opacity-50 cursor-not-allowed'}",
    data: { order_review_target: "submitAllBtn" } %>
