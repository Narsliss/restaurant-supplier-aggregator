<%# Header for the Confirmed section. Its own partial because confirming a
    match re-renders it (count + visibility) over Turbo. Locals: count %>
<div id="confirmed-matches-header" class="flex items-center gap-3 mb-3 <%= "hidden" if count.zero? %>">
  <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider border-l-4 border-green-500 pl-3">Confirmed</h3>
  <span id="confirmed-matches-count" class="text-xs text-gray-400"><%= count %></span>
  <div class="flex-1 border-t border-gray-200"></div>
</div>
