<%# Left column of a product match card row. The whole cell is the trigger that
    opens the matching modal (name + image + per-supplier matching). Locals:
      match           — the ProductMatch
      aggregated_list — the AggregatedList (for routes + promoted? check)
      comparison      — :exact / :single / :incomparable, from @price_data;
                        optional, defaults to nil (no verdict, no flag)
%>
<% comparison = local_assigns.fetch(:comparison, nil) %>
<% editable = !aggregated_list.promoted? %>
<% attrs = { id: "match_left_#{match.id}",
             class: "sm:w-48 md:w-56 shrink-0 p-4 border-b sm:border-b-0 sm:border-r border-gray-100" } %>
<% if editable %>
  <% attrs[:class] += " cursor-pointer hover:bg-brand-orange/5 transition-colors group" %>
  <% attrs[:title] = "Click to edit match & image" %>
  <% attrs[:data] = { controller: "open-match-modal",
                      open_match_modal_url_value: edit_aggregated_list_product_match_path(aggregated_list, match),
                      action: "click->open-match-modal#open" } %>
<% end %>

<%= tag.div(**attrs) do %>
  <div class="flex items-start gap-2">
    <%= render "product_matches/match_thumb", match: match %>

    <div class="flex-1 min-w-0">
      <h3 class="text-sm font-semibold text-gray-900 leading-tight"><%= match.display_name %></h3>
      <div class="mt-1.5 flex items-center gap-2 flex-wrap">
        <% if match.unmatched? %>
          <% teaser_suppliers = defined?(@teaser_map) ? (@teaser_map&.dig(match.id) || {}) : {} %>
          <% if teaser_suppliers.any? %>
            <%# The matcher DID find an equivalent — at a supplier the chef
                hasn't added. "Unmatched" here reads as failure; say what's
                actually true instead. %>
            <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-medium text-blue-700"
                  title="An equivalent product was found at a supplier you haven't added yet — see the greyed cell">
              Match available
            </span>
          <% else %>
            <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-medium text-amber-700">Unmatched</span>
          <% end %>
        <% end %>
        <%# A chef ordered this mid-shift off-list — one supplier, no price
            comparison yet. Sorted to the top of this page until reviewed. %>
        <% if match.needs_off_list_review? %>
          <span class="inline-flex items-center rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-bold text-white"
                title="Ordered by <%= match.off_list_added_by&.first_name.presence || 'a chef' %> without price comparison — confirm the match to mark it reviewed">
            Needs review
          </span>
        <% end %>
        <%# The suppliers on this line don't quote in a common unit — one sells
            by the each, another by the ounce, another by the sheet. There is no
            honest cheapest here, so no BEST badge goes out; this says why. %>
        <%# Ranked, but only because we converted a count or a bushel using a
            weight nobody stated. Outline rather than fill: the comparison
            stands, it just isn't resting on the suppliers' own numbers. %>
        <% if comparison == :estimated %>
          <span class="inline-flex items-center gap-1 rounded-full border border-amber-500 bg-white px-2 py-0.5 text-[10px] font-bold text-amber-700"
                title="These suppliers price in different units. The comparison uses an estimated pack weight, not one the suppliers stated — open the line to set it yourself.">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
            </svg>
            Estimated units
          </span>
        <% end %>
        <% if comparison == :incomparable %>
          <span class="inline-flex items-center gap-1 rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-bold text-white"
                title="These suppliers price in different units, so their prices can't be compared like for like. Check the pack sizes before ordering.">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
            </svg>
            Units don't match
          </span>
        <% end %>
        <%# A chef has signed off on this line. It sorts to the Confirmed
            section at the foot of the page, so the badge is what identifies
            it once it's down there. %>
        <% if match.confirmed? %>
          <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-medium text-green-700"
                title="A chef confirmed this match">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
            Chef confirmed
          </span>
        <% end %>
        <% if match.confidence_score && match.confidence_score > 0 %>
          <span class="text-xs <%= match.confidence_score >= 0.8 ? 'text-green-600' : 'text-amber-600' %>">
            <%= (match.confidence_score * 100).round %>%
          </span>
        <% end %>
      </div>
    </div>

    <% if editable %>
      <%# Edit affordance — makes it clear the row is clickable (opens the modal,
          where name/image/matching/remove all live) %>
      <span class="shrink-0 inline-flex items-center gap-0.5 text-[10px] font-medium text-gray-300 group-hover:text-brand-orange transition-colors" aria-hidden="true">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
        </svg>
      </span>
    <% end %>
  </div>
<% end %>
