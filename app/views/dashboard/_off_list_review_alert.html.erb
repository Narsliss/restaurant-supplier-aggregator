<%# Chefs ordered these mid-shift without them being on a matched list, so no
    price comparison has run. Mirrors the credential-health alert pattern. %>
<% if @unreviewed_off_list&.any? %>
  <% first_list = @unreviewed_off_list.first.aggregated_list %>
  <div class="mb-6 rounded-lg border-2 border-amber-300 bg-amber-50 p-4 sm:p-5" role="alert">
    <div class="flex items-start gap-3">
      <svg class="h-6 w-6 flex-shrink-0 text-amber-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.186c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L4.2 15.3" />
      </svg>
      <div class="flex-1 min-w-0">
        <h3 class="text-base font-heading font-bold text-amber-900">
          <%= pluralize(@unreviewed_off_list.size, "product") %> ordered without price comparison
        </h3>
        <p class="mt-1 text-sm text-amber-800">
          Chefs needed <%= @unreviewed_off_list.size == 1 ? "this" : "these" %> mid-shift and
          <%= @unreviewed_off_list.size == 1 ? "it wasn't" : "they weren't" %> on a matched list,
          so only one supplier is attached. Review
          <%= @unreviewed_off_list.size == 1 ? "it" : "them" %> to make sure you're getting the best price.
        </p>

        <ul class="mt-3 space-y-2">
          <% @unreviewed_off_list.first(5).each do |match| %>
            <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 bg-white rounded-md border border-amber-200 px-3 py-2.5">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate"><%= match.display_name %></p>
                <p class="text-xs text-amber-700 mt-0.5">
                  <%= match.product_match_items.first&.supplier&.name || "Unknown supplier" %>
                  <% if match.off_list_added_by %>
                    · added by <%= match.off_list_added_by.first_name.presence || match.off_list_added_by.email %>
                  <% end %>
                  <% if match.off_list_added_at %>
                    · <%= time_ago_in_words(match.off_list_added_at) %> ago
                  <% end %>
                </p>
              </div>
              <%= link_to "Review →", aggregated_list_path(match.aggregated_list),
                  class: "flex-shrink-0 inline-flex items-center justify-center rounded-md bg-amber-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-700 transition-colors" %>
            </li>
          <% end %>
        </ul>

        <% if @unreviewed_off_list.size > 5 && first_list %>
          <p class="mt-3 text-sm">
            <%= link_to "See all #{@unreviewed_off_list.size} in matching →",
                aggregated_list_path(first_list),
                class: "font-semibold text-amber-900 underline" %>
          </p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
