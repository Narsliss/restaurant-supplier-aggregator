<%# Re-render the whole card so price comparison recalculates %>
<%= turbo_stream.replace dom_id(@product_match) do %>
  <%= render "aggregated_lists/match_card",
             match: @product_match,
             aggregated_list: @aggregated_list,
             suppliers: @suppliers,
             supplier_map: @match_supplier_map[@product_match.id] || {},
             price_info: @price_info %>
<% end %>

<%# Remove any duplicate rows that were cleaned up %>
<% @removed_match_ids.each do |removed_id| %>
  <%= turbo_stream.remove "product_match_#{removed_id}" %>
<% end %>

<%# Refresh the open modal (matching happens there now) %>
<% @product_match.product_match_items.reload %>
<%= turbo_stream.replace "match_modal" do %>
  <%= render "product_matches/modal", match: @product_match, aggregated_list: @aggregated_list %>
<% end %>
