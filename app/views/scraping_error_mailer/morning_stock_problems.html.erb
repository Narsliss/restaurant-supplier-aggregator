<div style="max-width: 640px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1f2937;">
  <div style="padding: 28px 24px;">
    <div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
      <h1 style="font-size: 20px; font-weight: 700; margin: 0 0 6px; color: #991b1b;">Morning stock check: something didn't run right</h1>
      <p style="font-size: 14px; color: #7f1d1d; margin: 0; line-height: 1.5;">
        Stock for these suppliers wasn't fully read this morning, so "Out of stock" in the app may be out of date for them today.
      </p>
    </div>

    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
      <% @rows.each do |row| %>
        <tr style="border-bottom: 1px solid #f3f4f6;">
          <td style="padding: 10px 8px 10px 0; font-size: 14px; font-weight: 600; vertical-align: top; width: 160px;">
            <%= row[:supplier].name %>
            <div style="font-size: 12px; font-weight: 400; color: #6b7280;">
              mode: <%= row[:mode] %><%= " · last run #{row[:ran_at].in_time_zone('America/New_York').strftime('%b %-d %-l:%M %p')}" if row[:ran_at] %>
            </div>
          </td>
          <td style="padding: 10px 0; font-size: 14px; color: #111827;">
            <% row[:problems].each do |problem| %>
              <div style="margin-bottom: 4px;">• <%= problem %></div>
            <% end %>
            <div style="font-size: 12px; color: #6b7280;">
              Items on lists with a reading this morning: <%= row[:in_use_checked] %> of <%= row[:in_use_total] %>
            </div>
          </td>
        </tr>
      <% end %>
    </table>

    <p style="font-size: 12px; color: #9ca3af; line-height: 1.5; text-align: center;">
      Sent to the super admin only when the morning stock check finds a problem. Details on the Operations page.
    </p>
  </div>
</div>
