<%# A chef signed off on this match.
    1. Redraw the card's left column so the "Chef confirmed" badge appears.
    2. Drop in a one-shot mover that relocates the card to the Confirmed
       section at the foot of the page and updates that section's header.
    3. Close the modal — the work on this line is done. %>
<%= turbo_stream.replace "match_left_#{@product_match.id}" do %>
  <%= render "aggregated_lists/match_row_left", match: @product_match, aggregated_list: @aggregated_list,
                                              comparison: @product_match.unit_comparison %>
<% end %>

<%= turbo_stream.append "match-cards-container" do %>
  <div data-controller="move-to-confirmed"
       data-move-to-confirmed-match-id-value="<%= dom_id(@product_match) %>"
       data-move-to-confirmed-count-value="<%= @confirmed_count %>"></div>
<% end %>

<%= turbo_stream.update "match_modal", "" %>
