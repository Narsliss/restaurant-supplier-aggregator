<%# Set Weight — a chef supplying the pack weight this supplier never gave.
    Rendered inside a supplier cell in the matching modal, on the cells whose
    comparison rests on something other than a weight the supplier stated.
    Locals: match, item, supplier %>
<% existing = item.unit_override %>
<% stale = item.unit_override_stale? %>
<% pack = item.pack_size.presence || item.supplier_product&.pack_size %>
<% piece_count = UnitOverride.piece_count_in(pack) || 0 %>
<%# The other suppliers already on this line, in $/lb, so the preview can show
    what this number decides and not merely what it computes. %>
<% peers = match.prices_by_supplier.filter_map do |row|
     next if row[:supplier] == supplier
     basis = row[:item]&.comparison_per_oz
     next unless basis && basis[:value].to_f.positive?
     { name: row[:supplier].short_name.presence || row[:supplier].name, perLb: (basis[:value].to_f * 16).round(2) }
   end %>

<div class="mt-2 pt-2 border-t border-gray-200" data-controller="set-weight"
     data-set-weight-price-value="<%= item.price || item.supplier_product&.current_price %>"
     data-set-weight-piece-count-value="<%= piece_count %>"
     data-set-weight-supplier-value="<%= supplier.short_name.presence || supplier.name %>"
     data-set-weight-peers-value="<%= peers.to_json %>">

  <% if stale %>
    <p class="text-[10px] font-bold text-red-700">Weight out of date</p>
    <p class="text-[10px] text-gray-600 mb-1">
      Set against <span class="font-medium"><%= existing.pack_size_fingerprint %></span>,
      now sold as <span class="font-medium"><%= pack %></span>.
    </p>
  <% elsif existing %>
    <p class="text-[10px] text-gray-600 mb-1">
      <%= number_with_precision(existing.net_weight_oz / 16.0, precision: 2, strip_insignificant_zeros: true) %> lb
      <%= existing.basis == "per_piece" ? "each" : "per pack" %>,
      set by <%= existing.created_by_user&.first_name.presence || "a chef" %>
      <%= existing.confirmed_at ? l(existing.confirmed_at.to_date, format: :long) : "" %>
    </p>
  <% end %>

  <%# Stay open after a save. Re-rendering collapsed shrinks the cell and
      pulls the modal footer — where Confirm match lives — up towards where
      the Save button just was, which is a sign-off nobody asked for. %>
  <% just_saved = [params[:opened_item], params[:supplier_list_item_id]].map(&:to_s).include?(item.id.to_s) %>
  <details <%= "open" if stale || just_saved %>>
    <summary class="cursor-pointer text-[10px] font-semibold text-amber-700 select-none">
      <%= existing ? "Change weight" : "Set weight" %>
    </summary>

    <%= form_with url: unit_overrides_path, method: :post, class: "mt-1.5 flex flex-col gap-1.5" do %>
      <%= hidden_field_tag :supplier_list_item_id, item.id %>
      <%# Send the frame back to itself so the cell re-renders with the new
          weight, rather than to the list page, which replaces this frame with
          an empty one and reads as "nothing happened". %>
      <%= hidden_field_tag :return_to_match_id, match.id %>

      <p class="text-[10px] text-gray-700">
        How much does one whole <span class="font-semibold"><%= pack.presence || "pack" %></span>
        weigh, as it arrives? That is the unit the
        <%= number_to_currency(item.price || item.supplier_product&.current_price) %> buys.
      </p>

      <%# A supplier cell is narrow. Flex items will not shrink below their own
          content by default, so three controls on one row push straight out
          through the side of the card — min-w-0 lets them give, and the basis
          gets its own row rather than fighting for the last few pixels. %>
      <div class="flex gap-1 min-w-0">
        <%= number_field_tag :weight, existing&.then { |o| (o.net_weight_oz / 16.0).round(2) },
              step: "any", min: "0", placeholder: "28",
              class: "flex-1 min-w-0 text-xs border border-gray-300 rounded px-1.5 py-1",
              data: { set_weight_target: "weight", action: "input->set-weight#render" } %>

        <%= select_tag :unit, options_for_select([%w[lb lb], %w[oz oz], %w[kg kg]], "lb"),
              class: "shrink-0 w-14 text-xs border border-gray-300 rounded px-1 py-1",
              data: { set_weight_target: "unit", action: "change->set-weight#render" } %>
      </div>

      <%# "each one" is meaningless without saying each of WHAT: a 15x48 Count
          Case is 720 lady fingers, not 15 boxes, and a chef should not have to
          guess which we meant. The count goes in the label, and the option is
          dropped entirely when we cannot count the pieces. %>
      <% basis_options = [["that is the whole thing", "per_pack"]] %>
      <% basis_options << ["that is each one, x#{piece_count.to_i}", "per_piece"] if piece_count.to_i > 1 %>
      <% if basis_options.size > 1 %>
        <%= select_tag :basis, options_for_select(basis_options, existing&.basis || "per_pack"),
              class: "w-full min-w-0 text-xs border border-gray-300 rounded px-1 py-1",
              data: { set_weight_target: "basis", action: "change->set-weight#render" } %>
      <% else %>
        <%= hidden_field_tag :basis, "per_pack", data: { set_weight_target: "basis" } %>
      <% end %>

      <%# The guardrail: the price this number produces, beside the peers. %>
      <div class="rounded bg-gray-50 border border-gray-200 px-1.5 py-1">
        <p class="text-[10px] font-semibold text-gray-900" data-set-weight-target="preview"></p>
        <p class="text-[10px] text-gray-600" data-set-weight-target="verdict"></p>
      </div>

      <p class="text-[10px] text-gray-500 leading-snug">
        This is your estimate, not <%= supplier.name %>'s. If they change this pack we'll
        drop it and ask you again.
      </p>

      <%= submit_tag existing ? "Update" : "Save weight",
            class: "text-[10px] font-semibold text-white bg-brand-green rounded px-2 py-1 cursor-pointer" %>
    <% end %>

    <%# button_to renders its own <form>, so it has to live OUTSIDE the one
        above: a nested form is invalid HTML, the browser hoists it out, and
        Update ends up submitting with this button's DELETE verb. %>
    <% if existing %>
      <%= button_to "Remove weight", unit_override_for_item_path(supplier_list_item_id: item.id),
            method: :delete,
            params: { return_to_match_id: match.id },
            form: { class: "mt-1.5",
                    data: { turbo_confirm: "Remove this weight? The line goes back to comparing on what the suppliers stated." } },
            class: "text-[10px] font-semibold text-gray-600 border border-gray-300 rounded px-2 py-1" %>
    <% end %>
  </details>
</div>
