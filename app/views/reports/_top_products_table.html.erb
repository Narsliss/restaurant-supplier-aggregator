<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200">
    <h2 class="text-lg font-semibold text-gray-900">Top Products</h2>
  </div>
  <% if top_products.any? %>
    <%# Long supplier names truncate inside the cell: max-w-0 + w-full lets the
        name column take only the space left, so the numbers are never pushed
        out of the (overflow-hidden) card. max-w-xs on the <td> itself did
        nothing — browsers ignore max-width on table cells. %>
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Qty Ordered</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total Spent</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Orders</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% top_products.each do |product_name, qty, total, order_count| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900 w-full max-w-0" data-top-product-name>
              <div class="truncate" title="<%= product_name %>"><%= product_name %></div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 text-right whitespace-nowrap"><%= qty.round(1) %></td>
            <td class="px-6 py-4 text-sm text-gray-900 text-right whitespace-nowrap"><%= number_to_currency(total) %></td>
            <td class="px-6 py-4 text-sm text-gray-500 text-right whitespace-nowrap"><%= order_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <div class="px-6 py-8 text-center text-sm text-gray-400">No product data in this period</div>
  <% end %>
</div>
